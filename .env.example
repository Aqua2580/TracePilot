# TracePilot 环境变量示例（Phase 4 / Phase 5）
#
# 使用方法：
#   1. 复制本文件为 .env：`Copy-Item .env.example .env`
#   2. 填写真实值，.env 不会被提交（已在 .gitignore 第 32-34 行）
#   3. 重启 TracePilot API，.env 会被 process.loadEnvFile() 自动加载
#
# 安全说明：
#   - .env 仅填充 process.env 中缺失的项，已存在的环境变量不会被覆盖
#   - API key 仅通过 allowedEnvVarNames 白名单透传给 omp 子进程，
#     不会泄漏到 LocalCommandAdapter 的测试命令或其他子进程
#   - 切勿把真实 .env 提交到 git

# ---------------------------------------------------------------------------
# OmpAdapter 配置（Phase 4 真实修复闭环）
# ---------------------------------------------------------------------------

# omp 二进制路径（必填，启用 OmpAdapter）
# 留空则降级为 LocalCommandAdapter（ADR-001 MVP 兜底）
TRACEPILOT_OMP_PATH=C:\Users\YOUR_USERNAME\AppData\Local\omp\omp.exe

# 模型名称（可选，留空则用 omp 默认模型）
# 使用 DeepSeek 时填 deepseek-v4-flash 或 deepseek-v4-pro
# 使用 Anthropic 时填 claude-sonnet-4 等
TRACEPILOT_OMP_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------------------
# LLM API Key（按使用的提供商填一个即可）
# ---------------------------------------------------------------------------

# === DeepSeek（推荐方案）===
# omp 内置支持 DEEPSEEK_API_KEY（搜索二进制确认），直接用 DeepSeek 原生端点。
# 模型名用 deepseek-v4-flash 或 deepseek-v4-pro。
# 文档：https://api-docs.deepseek.com/zh-cn/
# 申请 key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-deepseek-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Anthropic Claude（原生）===
# 如不使用 DeepSeek，注释掉上面的 DEEPSEEK_API_KEY，并填入真实 Anthropic key。
# 模型名用 claude-sonnet-4 等。
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === OpenAI GPT ===
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Google Gemini ===
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Azure OpenAI ===
# AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Groq ===
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Cerebras ===
# CEREBRAS_API_KEY=csk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === OpenRouter 聚合网关（备用 DeepSeek 接入方案）===
# DeepSeek 也可通过 OpenRouter 接入，但上面的 Anthropic 兼容端点方案更直接。
# 获取 key：https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 其他支持的提供商（按需取消注释）：
# XAI_API_KEY=             # xAI Grok
# KILO_API_KEY=            # Kilo Gateway
# MISTRAL_API_KEY=         # Mistral
# ZAI_API_KEY=             # z.ai (ZhipuAI/GLM)
# MINIMAX_API_KEY=         # MiniMax
# OPENCODE_API_KEY=        # OpenCode Zen/Go
# AI_GATEWAY_API_KEY=      # Vercel AI Gateway
# WAFER_SERVERLESS_API_KEY= # Wafer Serverless

# ---------------------------------------------------------------------------
# 人工审批通道（Phase 5，执行人工批准/拒绝时必填）
# ---------------------------------------------------------------------------

# 服务端可信人工身份。HTTP 请求体不能覆盖该值。
TRACEPILOT_HUMAN_APPROVER=product-owner

# 仅供本地人类 UI/CLI 通道使用的共享凭证；至少 32 个字符。
# 请用 README 的 PowerShell 命令生成随机值，不要复用 LLM API key，
# 不要把真实值提交到 Git，也不要把它注入 Omp 或项目验证进程。
# 留空时人工审批 API 按设计以 503 失败关闭。
TRACEPILOT_HUMAN_APPROVAL_SECRET=

# ---------------------------------------------------------------------------
# TracePilot 运行时配置（可选，通常用默认值即可）
# ---------------------------------------------------------------------------

# API 监听端口（默认 7431）
# TRACEPILOT_PORT=7431

# API 监听地址（默认 127.0.0.1，仅本机访问）
# TRACEPILOT_HOST=127.0.0.1

# SQLite 数据库路径（默认 %LOCALAPPDATA%/TracePilot/tracepilot.db）
# TRACEPILOT_DB_PATH=

# 受控 worktree 根目录（默认 %LOCALAPPDATA%/TracePilot/worktrees）
# TRACEPILOT_WORKTREE_ROOT=

# 日志级别（默认 info）
# LOG_LEVEL=info
